# Line endings stay LF in the repo whatever the clone's core.autocrlf (avd-ops docs/run-anywhere.md).
* text=auto eol=lf
*.sh text eol=lf

# Vendored contract files are hashed byte for byte (PINS.json).
contracts/*.json -text
# So is the design system copy (site/assets/MANIFEST.json).
site/assets/* -text
site/assets/brand/* -text
site/assets/fonts/* -text
