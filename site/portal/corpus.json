      "version": "1.0.0",
      "title": "Concurrent session logon storm",
      "summary": "Measures staggered/concurrent sign-in duration, FSLogix profile load time, peak CPU, and minimum available memory.",
      "primaryMetric": "timeToConnectMsP95",
      "primaryUnit": "ms",
      "experienceGate": "timeToConnectMsP95 <= 30000 ms"
